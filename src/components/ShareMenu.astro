---
// 《种子》三部曲 · 分享菜单
// 顶栏分享按钮 + 弹出层（二维码 + 复制链接 + 原生分享 + 社交分享）
// 二维码由 qrcode-generator（MIT）客户端生成，无外部 API 依赖
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<button class="tool-btn share-btn" type="button" data-share-open
  aria-label="分享"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="share-modal">
  <svg class="tool-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="6" cy="12" r="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="18" cy="6" r="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="18" cy="18" r="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/>
    <path d="M8.1 11l7.8-4M8.1 13l7.8 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
  <span class="share-label" data-i18n="share.btn">分享</span>
</button>

<div class="share-modal" id="share-modal" hidden role="dialog" aria-modal="true" aria-labelledby="share-title">
  <div class="share-backdrop" data-share-close></div>
  <div class="share-panel" role="document">
    <div class="share-head">
      <h2 id="share-title" data-i18n="share.title">分享这一页</h2>
      <button class="share-close" type="button" data-share-close aria-label="关闭">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="share-qr-wrap">
      <div class="share-qr" id="share-qr" aria-live="polite" data-i18n="share.qrHint">生成二维码中…</div>
      <p class="share-qr-tip" data-i18n="share.qrTip">微信扫一扫，在手机上阅读</p>
    </div>

    <div class="share-url-row">
      <input class="share-url" id="share-url" type="text" readonly aria-label="链接" />
      <button class="share-copy" type="button" id="share-copy" data-i18n="share.copy">复制</button>
    </div>

    <div class="share-actions">
      <button class="share-native" type="button" id="share-native" hidden data-i18n="share.native">系统分享</button>
      <button class="share-svc share-svc--wechat" type="button" id="share-wechat-btn">
        <span data-i18n="share.wechat">微信</span>
      </button>
      <a class="share-svc share-svc--weibo" href="#" target="_blank" rel="noopener noreferrer" data-share-svc="weibo">
        <span data-i18n="share.weibo">微博</span>
      </a>
      <a class="share-svc share-svc--twitter" href="#" target="_blank" rel="noopener noreferrer" data-share-svc="twitter">
        <span data-i18n="share.twitter">X</span>
      </a>
    </div>

    <p class="share-toast" id="share-toast" hidden data-i18n="share.wechatTip">在微信中打开 → 长按识别上方二维码</p>
  </div>
</div>

<style is:global>
  /* 顶栏分享按钮 */
  .share-btn .share-label { display: inline; }
  .site-head .share-btn { margin-left: 0.2rem; }
  @media (max-width: 720px) {
    .site-head .share-btn .share-label { display: none; }
    .site-head .share-btn { padding: 0.45rem 0.55rem; }
  }

  /* 弹出层 */
  .share-modal {
    position: fixed; inset: 0; z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    overflow-y: auto;
  }
  .share-modal[hidden] { display: none; }
  .share-backdrop {
    position: absolute; inset: 0;
    background: rgba(5,5,6,0.6);
    backdrop-filter: blur(3px);
  }
  .share-panel {
    position: relative; z-index: 1;
    width: min(420px, calc(100vw - 2rem));
    margin: auto;
    background: var(--paper);
    border: 1px solid var(--mute-15);
    border-radius: 12px;
    box-shadow: 0 24px 60px -12px rgba(0,0,0,0.45);
    padding: 1.5rem;
  }
  .share-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .share-head h2 {
    font-family: var(--serif); font-weight: 500;
    font-size: var(--step-1); letter-spacing: 0.04em;
  }
  .share-close {
    color: var(--mute-50); padding: 0.3rem; border-radius: 6px;
    transition: background .2s, color .2s;
  }
  .share-close:hover { background: var(--paper-2); color: var(--ink); }

  /* 二维码 */
  .share-qr-wrap { display: grid; place-items: center; margin-bottom: 1.2rem; }
  .share-qr {
    width: 220px; height: 220px;
    box-sizing: content-box;
    background: var(--paper-2);
    border: 1px solid var(--mute-15);
    border-radius: 8px;
    display: grid; place-items: center;
    overflow: hidden;
  }
  .share-qr svg {
    display: block;
    width: 100%; height: 100%;
    max-width: 100%; max-height: 100%;
  }
  .share-qr-tip {
    margin-top: 0.7rem; text-align: center;
    font-family: var(--sans); font-size: var(--step--1);
    letter-spacing: 0.06em; color: var(--mute-50);
  }

  /* 链接 + 复制 */
  .share-url-row {
    display: flex; gap: 0.4rem; margin-bottom: 1rem;
  }
  .share-url {
    flex: 1; min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--mute-15);
    border-radius: 6px; background: var(--paper-2);
    font-family: var(--mono); font-size: 0.74rem;
    color: var(--mute-65); overflow: hidden; text-overflow: ellipsis;
  }
  .share-url:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .share-copy {
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--ink);
    border-radius: 6px;
    font-family: var(--sans); font-size: var(--step--1);
    letter-spacing: 0.06em; color: var(--ink);
    transition: background .2s, color .2s;
  }
  .share-copy:hover { background: var(--ink); color: var(--paper); }
  .share-copy.copied { background: var(--ink); color: var(--paper); }

  /* 分享按钮区 */
  .share-actions {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    justify-content: center;
  }
  .share-native, .share-svc {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--mute-15);
    border-radius: 6px;
    font-family: var(--sans); font-size: var(--step--1);
    letter-spacing: 0.06em; color: var(--mute-65);
    transition: background .2s, color .2s, border-color .2s;
  }
  .share-native:hover, .share-svc:hover {
    background: var(--paper-2); color: var(--ink); border-color: var(--mute-35);
  }
  .share-svc--wechat:hover { color: #07c160; border-color: #07c160; }
  .share-svc--weibo:hover { color: #e6162d; border-color: #e6162d; }
  .share-svc--twitter:hover { color: #1d9bf0; border-color: #1d9bf0; }

  /* 微信引导 toast */
  .share-toast {
    margin-top: 0.8rem; text-align: center;
    font-family: var(--sans); font-size: var(--step--1);
    letter-spacing: 0.06em; color: var(--mute-50);
    transition: opacity .2s;
  }
  .share-toast[hidden] { display: none; }
  .share-toast.show { color: var(--red); }

  @media (max-width: 560px) {
    .share-qr { width: 180px; height: 180px; }
    .share-actions { gap: 0.3rem; }
    .share-native, .share-svc { padding: 0.5rem 0.7rem; font-size: 0.72rem; }
  }
</style>

<script>
  import qrcode from 'qrcode-generator';

  const modal = document.getElementById('share-modal');
  const btn = document.querySelector('[data-share-open]');
  const qrEl = document.getElementById('share-qr');
  const urlInput = document.getElementById('share-url') as HTMLInputElement;
  const copyBtn = document.getElementById('share-copy') as HTMLButtonElement;
  const nativeBtn = document.getElementById('share-native') as HTMLButtonElement;
  const wechatBtn = document.getElementById('share-wechat-btn') as HTMLButtonElement;
  const toast = document.getElementById('share-toast');

  let lastUrl = '';

  function currentUrl() {
    // 优先使用 canonical，回退到 location.href
    const canonical = document.querySelector('link[rel="canonical"]');
    if (canonical) {
      const href = canonical.getAttribute('href') || '';
      if (href) return href;
    }
    return window.location.href;
  }

  function renderQR(url: string) {
    try {
      // 自动选版本，L 级纠错，UTF-8 字节模式
      const qr = qrcode(0, 'L');
      qr.addData(url);
      qr.make();
      const svg = qr.createSvgTag({ cellSize: 4, margin: 4, scalable: true });
      qrEl.innerHTML = svg;
      qrEl.setAttribute('aria-label', '页面二维码');
    } catch (err) {
      qrEl.textContent = '二维码生成失败';
      console.error('QR error:', err);
    }
  }

  function showToast(msg?: string) {
    if (!toast) return;
    if (msg) toast.textContent = msg;
    toast.hidden = false;
    toast.classList.add('show');
    setTimeout(() => {
      toast.hidden = true;
      toast.classList.remove('show');
    }, 2500);
  }

  function openModal() {
    const url = currentUrl();
    lastUrl = url;
    urlInput.value = url;
    renderQR(url);
    modal.hidden = false;
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // 微博
    const weiboLink = document.querySelector('[data-share-svc="weibo"]') as HTMLAnchorElement;
    if (weiboLink) {
      const title = document.title;
      weiboLink.href = `https://service.weibo.com/share/share.php?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`;
    }
    // Twitter / X
    const twitterLink = document.querySelector('[data-share-svc="twitter"]') as HTMLAnchorElement;
    if (twitterLink) {
      const title = document.title;
      twitterLink.href = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
    }
    // 关闭后聚焦复制按钮
    setTimeout(() => copyBtn?.focus(), 50);
  }

  function closeModal() {
    modal.hidden = true;
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    btn?.focus();
  }

  // —— 微信分享 ——
  // 浏览器无法直接调起微信分享 API（需要 JSSDK 与公众号鉴权）
  // 实际可行的方案就是用二维码：手机端用微信扫一扫，桌面端截图发给微信好友
  wechatBtn?.addEventListener('click', () => {
    showToast();
    qrEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  btn?.addEventListener('click', openModal);
  document.querySelectorAll('[data-share-close]').forEach((el) => {
    el.addEventListener('click', closeModal);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  // 复制链接
  copyBtn?.addEventListener('click', async () => {
    const lang = (document.documentElement.getAttribute('data-lang')) || 'zh';
    const dict = (window as any).SEED_I18N || { zh: {}, en: {} };
    const copiedText = (dict[lang] && dict[lang]['share.copied']) || (lang === 'en' ? 'Copied' : '已复制');
    const defaultText = (dict[lang] && dict[lang]['share.copy']) || (lang === 'en' ? 'Copy' : '复制');
    try {
      await navigator.clipboard.writeText(lastUrl);
      copyBtn.textContent = '✓ ' + copiedText;
      copyBtn.classList.add('copied');
      setTimeout(() => {
        copyBtn.textContent = defaultText;
        copyBtn.classList.remove('copied');
      }, 1500);
    } catch {
      // 兜底：选中文本
      urlInput.focus();
      urlInput.select();
      try { document.execCommand('copy'); } catch (e) {}
    }
  });

  // 原生分享（仅支持的浏览器显示按钮）
  if (nativeBtn && navigator.share) {
    nativeBtn.hidden = false;
    nativeBtn.addEventListener('click', async () => {
      try {
        await navigator.share({
          title: document.title,
          url: lastUrl,
        });
      } catch (err) {
        if (err.name !== 'AbortError') console.error('Share failed:', err);
      }
    });
  }
</script>
