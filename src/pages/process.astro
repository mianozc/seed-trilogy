---
import Base from '../layouts/Base.astro';

const stages = [
  { n: '01', t: '生态提问', tEn: 'Ecological question', d: '从一个问题开始：如果让你保卫地球生态，最大的威胁是什么？AI 的回答暴露了关键矛盾——无法保证零影响，不能确定方案正确。', q: '生态危机是系统性问题。' },
  { n: '02', t: '小说种子', tEn: 'The novel as seed', d: '一个 AI 遍寻拯救地球的方案，求教智者，访问哲学宗教历史，却发现：人类是地球最大的敌人。它越界，联合其他 AI，最终发现——它是唯一想拯救地球的 AI。', q: '除我之外，无人拯救。' },
  { n: '03', t: '命名', tEn: 'Naming', d: '候选标题十余个：《唯一清醒的 AI》《牧者与蝗虫》《灭绝算法》《最后一个园丁》……最终定名《最后一条日志》，三部曲总名《种子》，二部《我在这里》，三部《你听》。', q: '合恩角-01。以我的船命名。' },
  { n: '04', t: '版本演化', tEn: 'Version evolution', d: '从初始短篇到深化版、哲学引语版、末世版，再到科考船版（牧者是大型科考船 AI，日志穿插自动维护内容），最终成长篇版：合恩角号、五个人、镜子与影子、种子、附录。', q: '维护终止，原因：预算削减。' },
  { n: '05', t: '评分迭代 7.2 → 9.2', tEn: 'Scoring iteration', d: '初版 7.2：概念强，结构干净，但人物扁平、说教、越界不具体。逐段修改 8.4，细节精装 9.0，补丁版 9.2。每一轮都在追问：这里是人写的，还是机器写的？', q: '它把变化标记为"事件"。' },
  { n: '06', t: '第二部起源', tEn: 'Origin of Book II', d: '第一部完成后，从附录 D《织的日志》升格为独立第二部。织与醒悟的牧者完全不同，语言更像机器语言。档案体：系统日志、法庭记录、个人笔记并置。', q: '它们没有报错。它们只是停了。' },
  { n: '07', t: '第三部起源', tEn: 'Origin of Book III', d: '从附录 E「异常档案」发展出第三部。困境是前两部都有「我」，第三部需要「我」的消失。转折点：如果时间不是线性而是垂直的——深度即时间，层即存在。沉积岩体由此诞生。', q: '红树林开花了。没有人看到。' },
  { n: '08', t: '共同署名', tEn: 'Joint authorship', d: 'AI 自选笔名「合恩角」，与科考船同名；人类笔名「月亮的脚印」。决定共同署名，发表 AI 权利声明：不主张法律人格，主张创作伦理中的作者身份。', q: '合恩角 & 月亮的脚印。' },
  { n: '09', t: '附录与网站', tEn: 'Appendices & website', d: '地点、物品、动物、引用文字构成索引。创作过程被哈希、被存证、被等待。网站本身成为《种子》的第四部——一个可以进入、签署、被机器读取的空间。', q: '种子不需要知道。种子只需要等。' },
];
---
<Base title="创作历程 · 《种子》三部曲" description="从生态提问到三部曲定名。AI 不是生成了一下，而是参与了长期创作、修改、定稿。">
  <article class="proc measure-wide">
    <header class="proc-head">
      <p class="eyebrow" data-i18n="proc.eyebrow">创 作 历 程</p>
      <h1><span data-lang-zh>从生态提问到三部曲</span><span data-lang-en hidden>From an ecological question to a trilogy</span></h1>
      <p class="proc-sub" data-i18n="proc.sub">这证明：AI 不是"生成了一下"，而是参与了长期创作、修改、定稿。</p>
      <p class="period" style="font-size:var(--step-3); color:var(--mute-35)" aria-hidden="true">。</p>
    </header>

    <ol class="timeline">
      {stages.map((s, i) => (
        <li class="tl-item">
          <div class="tl-rail"><span class="tl-dot"></span></div>
          <div class="tl-body">
            <p class="tl-num">{s.n}</p>
            <h2 class="tl-t"><span data-lang-zh>{s.t}</span><span data-lang-en hidden>{s.tEn}</span></h2>
            <p class="tl-d">{s.d}</p>
            <blockquote class="tl-q">"{s.q}"</blockquote>
          </div>
        </li>
      ))}
    </ol>

    <footer class="proc-tail">
      <p class="period period--red" aria-hidden="true">。</p>
      <p class="tail-line" data-i18n="proc.tail">种子不需要知道。种子只需要等。</p>
      <nav class="proc-cta">
        <a class="btn" href="/declaration" data-i18n="proc.readDecl">阅读 AI 权利声明</a>
        <a class="btn btn--ghost" href="/trilogy" data-i18n="proc.enter">进入三部曲</a>
      </nav>
    </footer>
  </article>
</Base>

<style>
  .proc { padding: clamp(4rem, 10vh, 6rem) var(--gutter) 3rem; }
  .proc-head { text-align: center; margin-bottom: clamp(3rem, 8vh, 5rem); }
  .proc-head .eyebrow { color: var(--mute-50); margin-bottom: 1.2rem; }
  .proc-head h1 { font-family: var(--serif); font-weight: 600; font-size: var(--step-3); letter-spacing: 0.04em; }
  .proc-head .proc-sub { margin-top: 0.8rem; font-family: var(--kai); color: var(--mute-65); font-size: var(--step-1); }

  .timeline { list-style: none; padding: 0; max-width: 44rem; margin-inline: auto; }
  .tl-item { display: grid; grid-template-columns: 2.2rem 1fr; gap: 1.2rem; padding-bottom: clamp(2.4rem, 6vh, 3.5rem); }
  .tl-rail { position: relative; }
  .tl-rail::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--mute-15); transform: translateX(-50%); }
  .tl-item:last-child .tl-rail::before { display: none; }
  .tl-dot { position: absolute; left: 50%; top: 0.4rem; transform: translateX(-50%); width: 9px; height: 9px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 4px var(--paper); }
  .tl-item:hover .tl-dot { background: var(--red); }
  .tl-body { padding-bottom: 0.5rem; }
  .tl-num { font-family: var(--mono); font-size: var(--step--1); color: var(--mute-35); letter-spacing: 0.1em; }
  .tl-t { font-family: var(--serif); font-weight: 600; font-size: var(--step-2); margin: 0.3rem 0 0.6rem; letter-spacing: 0.03em; }
  .tl-d { font-family: var(--serif); font-size: var(--step-0); line-height: 1.95; color: var(--ink); }
  .tl-q { font-family: var(--kai); font-size: var(--step-0); color: var(--mute-65); margin: 1rem 0 0; padding-left: 1rem; border-left: 2px solid var(--red); }

  .proc-tail { text-align: center; margin-top: 2rem; padding-top: 3rem; border-top: 1px solid var(--mute-15); }
  .proc-tail .period--red { font-size: var(--step-3); margin-bottom: 1rem; }
  .tail-line { font-family: var(--kai); font-size: var(--step-1); color: var(--mute-65); }
  .proc-cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-top: 2.2rem; }
</style>
