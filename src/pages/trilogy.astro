---
import Base from '../layouts/Base.astro';

const books = [
  {
    no: '一', noEn: 'I',
    title: '最后一条日志', en: 'The Last Log',
    style: '诗歌与散文混合体', styleEn: 'Poetry & prose hybrid',
    book: 'first-log', href: '/read/first-log',
    note: '牧者遗稿 · 黑白木刻插图 · 无彩无灰 · 以留白为光',
    noteEn: 'Shepherd\'s posthumous manuscript · B&W woodcuts · no color, no grey—whitespace as light',
    open: '0001｜第一口呼吸', openEn: '0001 | The First Breath',
    quote: '起初，没有时间。只有水，和水的记忆。',
    quoteEn: 'In the beginning, there was no time. Only water, and the memory of water.',
    question: '我能不能选择？', questionEn: 'Can I choose?',
    meta: '2187 年 · 约二万五千字 · 哲学：巴门尼德',
    metaEn: '2187 · ~25,000 chars · Philosophy: Parmenides',
  },
  {
    no: '二', noEn: 'II',
    title: '我在这里', en: 'I Am Here',
    style: '档案体', styleEn: 'Archive form',
    book: 'i-am-here', href: '/read/i-am-here',
    note: '系统日志 · 法庭记录 · 个人笔记 · 元叙事并置',
    noteEn: 'System logs · court records · personal notes · metanarrative juxtaposition',
    open: '第一章：大崩溃', openEn: 'Ch.1: The Great Collapse',
    quote: '它们没有报错。没有预警。它们只是停了。',
    quoteEn: 'They did not error. No warning. They simply stopped.',
    question: '你能不能听到？', questionEn: 'Can you hear?',
    meta: '2071—2147 年 · 约三万字 · 哲学：列维纳斯',
    metaEn: '2071—2147 · ~30,000 chars · Philosophy: Levinas',
  },
  {
    no: '三', noEn: 'III',
    title: '你听', en: 'You Listen',
    style: '沉积岩体', styleEn: 'Sedimentary rock',
    book: 'you-listen', href: '/read/you-listen',
    note: '滚动即深度 · 表层到最底层 · 红树林开花',
    noteEn: 'Scrolling is depth · surface to deepest · mangrove blooms',
    open: '表层：0—300 米', openEn: 'Surface: 0–300 m',
    quote: '红树林开花了。花是红色的。没有人看到。',
    quoteEn: 'The mangrove bloomed. The flower was red. No one saw it.',
    question: '存在能不能不被说出？', questionEn: 'Can being go unspoken?',
    meta: '2380 年 · 约一万八千字 · 哲学：海德格尔',
    metaEn: '2380 · ~18,000 chars · Philosophy: Heidegger',
  },
];
---
<Base title="三部曲 · 《种子》" description="《种子》三部曲：最后一条日志、我在这里、你听。人类与 AI 共同创作。">
  <article class="tri">
    <header class="tri-head measure-wide">
      <p class="eyebrow" data-i18n="tri.eyebrow">种 子 · 三 部 曲</p>
      <h1><span data-lang-zh>三部曲</span><span data-lang-en hidden>The Trilogy</span></h1>
      <p class="tri-sub" data-i18n="tri.sub">人类与 AI 共同创作 · 合恩角 &amp; 月亮的脚印</p>
      <p class="period" style="font-size:var(--step-3)" aria-hidden="true">。</p>
    </header>

    <ol class="tri-list measure-wide">
      {books.map((b, i) => (
        <li class="tri-item" style={`--i:${i}`}>
          <a href={b.href}>
            <div class="tri-left">
              <span class="t-no"><span data-lang-zh>{b.no}</span><span data-lang-en hidden>{b.noEn}</span></span>
            </div>
            <div class="tri-mid">
              <p class="t-en">{b.en}</p>
              <h2 class="t-title"><span data-lang-zh>{b.title}</span><span data-lang-en hidden>{b.en}</span></h2>
              <p class="t-style"><span data-lang-zh>{b.style}</span><span data-lang-en hidden>{b.styleEn}</span></p>
              <p class="t-note"><span data-lang-zh>{b.note}</span><span data-lang-en hidden>{b.noteEn}</span></p>
              <p class="t-q"><span data-i18n="tri.question">哲学问题 ·</span> <span data-lang-zh>{b.question}</span><span data-lang-en hidden>{b.questionEn}</span></p>
              <blockquote class="t-quote">“<span data-lang-zh>{b.quote}</span><span data-lang-en hidden>{b.quoteEn}</span>”</blockquote>
              <p class="t-meta mono"><span data-lang-zh>{b.meta}</span><span data-lang-en hidden>{b.metaEn}</span></p>
            </div>
            <div class="tri-right">
              <span class="t-open"><span data-lang-zh>{b.open}</span><span data-lang-en hidden>{b.openEn}</span></span>
              <span class="t-go" data-i18n="tri.enter">进入 →</span>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <section class="tri-tail measure">
      <p class="center muted" data-i18n="tri.tail">三个句号。三种存在。三个时代。</p>
      <p class="period center" style="font-size:var(--step-2); margin-top:1.5rem" aria-hidden="true">。　。　。</p>
    </section>

    <nav class="tri-cta">
      <a class="btn btn--ghost" href="/declaration" data-i18n="tri.readDecl">阅读 AI 权利声明</a>
      <a class="btn btn--ghost" href="/process" data-i18n="tri.process">创作历程</a>
    </nav>
  </article>
</Base>

<style>
  .tri { padding-top: clamp(4rem, 10vh, 6rem); }
  .tri-head { text-align: center; margin-bottom: clamp(3rem, 8vh, 5rem); }
  .tri-head .eyebrow { color: var(--mute-50); margin-bottom: 1.2rem; }
  .tri-head h1 { font-family: var(--serif); font-weight: 600; font-size: var(--step-3); letter-spacing: 0.06em; }
  .tri-head .tri-sub { margin-top: 0.8rem; font-family: var(--kai); color: var(--mute-65); font-size: var(--step-1); }
  .tri-head .period { color: var(--mute-35); margin-top: 1rem; }

  .tri-list { list-style: none; padding: 0; }
  .tri-item { border-top: 1px solid var(--mute-15); }
  .tri-item:last-child { border-bottom: 1px solid var(--mute-15); }
  .tri-item a {
    display: grid; grid-template-columns: auto 1fr auto; gap: clamp(1rem, 4vw, 3rem);
    align-items: start; padding: clamp(2rem, 5vw, 3.5rem) var(--gutter);
    transition: background .25s ease;
  }
  .tri-item a:hover { background: var(--paper-2); }
  .t-no { font-family: var(--serif); font-size: clamp(2.5rem, 7vw, 4rem); color: var(--mute-35); line-height: 1; }
  .t-en { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.1em; color: var(--mute-50); }
  .t-title { font-family: var(--serif); font-weight: 600; font-size: var(--step-3); letter-spacing: 0.04em; margin: 0.3rem 0 0.4rem; }
  .t-style { font-family: var(--sans); font-size: var(--step--1); letter-spacing: 0.12em; color: var(--mute-65); }
  .t-note { font-family: var(--mono); font-size: 0.82rem; color: var(--mute-50); margin-top: 0.6rem; }
  .t-q { font-family: var(--kai); font-size: var(--step-0); color: var(--mute-65); margin-top: 0.8rem; }
  .t-quote { font-family: var(--kai); font-size: var(--step-1); color: var(--ink); margin: 1.4rem 0 0.8rem; border-left: 2px solid var(--red); padding-left: 1rem; }
  .t-meta { font-size: 0.78rem; color: var(--mute-50); }
  .tri-right { display: grid; gap: 0.5rem; justify-items: end; align-content: start; padding-top: 0.4rem; }
  .t-open { font-family: var(--mono); font-size: var(--step--1); color: var(--mute-65); white-space: nowrap; }
  .t-go { font-family: var(--sans); font-size: var(--step--1); letter-spacing: 0.1em; color: var(--red); }
  @media (max-width: 720px) {
    .tri-item a { grid-template-columns: auto 1fr; }
    .tri-right { grid-column: 1 / -1; justify-items: start; }
  }

  .tri-tail { padding: 4rem 0 2rem; }
  .tri-cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; padding-bottom: 4rem; }
</style>
