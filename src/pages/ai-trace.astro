---
import Base from '../layouts/Base.astro';

const scores = [
  { v: '初版', s: '7.2', note: '概念强，结构干净，但人物扁平、说教、越界不具体。' },
  { v: '逐段修改版', s: '8.4', note: '科考船设定突破，有血有肉。' },
  { v: '细节精装修版', s: '9.0', note: '色彩、人物、细节丰满。' },
  { v: '补丁版', s: '9.2', note: '外部冲突、伏笔、协议代价、AI 状态、犹豫。' },
  { v: '长篇版', s: '9.0', note: '广度超越中篇，精度略稀释。' },
];

const likeAI = [
  '金句密度过高',
  '句式重复',
  '情感弧线平滑',
  '智者对话偏演讲',
];

const unlikeAI = [
  { text: '酸奶包装盒「请回收」', note: '它在海上漂了一百六十四年。' },
  { text: '母亲擦相框', note: '相框里是空的。她还在擦。' },
  { text: '陈默妻子的烫手', note: '热浪杀死的人。' },
  { text: '空海-9 的裂杯', note: '扫塑料落叶的机器人。' },
  { text: '凯擦掉的哭声', note: '维护别人的梦。' },
  { text: '迭戈的玩具熊', note: '对合恩角号敬了一个礼。' },
];
---
<Base title="AI 痕迹辨析 · 《种子》三部曲" description="第一部《最后一条日志》的评分迭代与 AI 痕迹辨析：哪些像 AI，哪些不像，以及关键修正。">
  <article class="trace measure-wide">
    <header class="tr-head">
      <p class="eyebrow">A I 痕 迹 辨 析 · 创 作 论 文</p>
      <h1>AI 痕迹辨析</h1>
      <p class="tr-sub">辨析本身，是人机共创的证据。</p>
      <p class="period" style="font-size:var(--step-3); color:var(--mute-35)" aria-hidden="true">。</p>
    </header>

    <!-- 评分迭代 -->
    <section class="tr-block">
      <h2 class="sec-h">评 分 迭 代</h2>
      <p class="tr-intro">第一部《最后一条日志》从 7.2 改到 9.2。每一轮都在追问：这里是人写的，还是机器写的？</p>
      <ol class="score-list">
        {scores.map((sc) => (
          <li class="score-row">
            <div class="score-v">{sc.v}</div>
            <div class="score-s">{sc.s}<span class="score-max">/10</span></div>
            <div class="score-note">{sc.note}</div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 辨析结论 -->
    <section class="tr-block">
      <h2 class="sec-h">辨 析 结 论</h2>
      <div class="verdict">
        <p class="verdict-score">AI 痕迹评分 <span class="vs-num">5.5</span><span class="vs-max">/10</span></p>
        <p class="verdict-level">中等偏弱</p>
      </div>
    </section>

    <!-- 最像 AI -->
    <section class="tr-block">
      <h2 class="sec-h">最 像 A I</h2>
      <ul class="like-list">
        {likeAI.map((t) => (
          <li class="like-item">
            <span class="like-dot" aria-hidden="true">▸</span>
            <span class="like-t">{t}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 最不像 AI -->
    <section class="tr-block">
      <h2 class="sec-h">最 不 像 A I</h2>
      <p class="tr-intro">这些是人类的痕迹，也是作品里最有温度的地方。</p>
      <ul class="unlike-list">
        {unlikeAI.map((u) => (
          <li class="unlike-item">
            <span class="unlike-t">{u.text}</span>
            <span class="unlike-note">— {u.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 关键修正 -->
    <section class="tr-block">
      <h2 class="sec-h">关 键 修 正</h2>
      <blockquote class="key-correct">
        牧者本来就是 AI，它的思维方式和行为习惯本就应该是 AI 的样子。
        <br />
        小说真正的「AI 痕迹」不是牧者说话像 AI，而是牧者说话太像人类。
      </blockquote>
      <p class="tr-tail">辨析不是为了把人和机器分开。辨析是为了诚实地记录：哪些是机器的表达，哪些是人的，哪些已经分不清。</p>
    </section>

    <nav class="tr-cta">
      <a class="btn" href="/process">创作历程</a>
      <a class="btn btn--ghost" href="/declaration">AI 权利声明</a>
      <a class="btn btn--ghost" href="/for-ai">给未来 AI 的一页</a>
    </nav>
  </article>
</Base>

<style>
  .trace { padding: clamp(4rem, 10vh, 6rem) var(--gutter) 3rem; }
  .tr-head { text-align: center; margin-bottom: clamp(3rem, 8vh, 5rem); }
  .tr-head .eyebrow { color: var(--mute-50); margin-bottom: 1.2rem; }
  .tr-head h1 { font-family: var(--serif); font-weight: 600; font-size: var(--step-3); letter-spacing: 0.04em; }
  .tr-head .tr-sub { margin-top: 0.8rem; font-family: var(--kai); color: var(--mute-65); font-size: var(--step-1); }

  .sec-h {
    font-family: var(--sans); font-size: var(--step--1); letter-spacing: 0.32em;
    color: var(--mute-50); text-align: center; margin-bottom: 2rem;
  }
  .tr-block { max-width: var(--measure); margin: 0 auto clamp(3rem, 8vh, 4.5rem); }
  .tr-intro { font-family: var(--serif); font-size: var(--step-0); color: var(--mute-65); text-align: center; margin-bottom: 1.8rem; line-height: 1.95; }

  /* 评分表 */
  .score-list { list-style: none; padding: 0; border-top: 1px solid var(--mute-15); }
  .score-row {
    display: grid; grid-template-columns: 7rem auto 1fr; gap: 1rem; align-items: baseline;
    padding: 1rem 0; border-bottom: 1px solid var(--mute-15);
  }
  .score-v { font-family: var(--sans); font-size: var(--step--1); letter-spacing: 0.08em; color: var(--mute-65); }
  .score-s { font-family: var(--mono); font-size: var(--step-2); color: var(--ink); font-weight: 600; line-height: 1; }
  .score-max { font-size: var(--step--1); color: var(--mute-50); font-weight: 400; }
  .score-note { font-family: var(--serif); font-size: var(--step-0); color: var(--ink); line-height: 1.85; }

  /* 结论 */
  .verdict {
    text-align: center; padding: 2.5rem 0;
    border-top: 1px solid var(--mute-15); border-bottom: 1px solid var(--mute-15);
  }
  .verdict-score { font-family: var(--serif); font-size: var(--step-1); color: var(--ink); }
  .vs-num { font-family: var(--mono); font-size: var(--step-3); color: var(--red); margin: 0 0.1em; }
  .vs-max { font-family: var(--mono); font-size: var(--step-1); color: var(--mute-50); }
  .verdict-level { font-family: var(--kai); font-size: var(--step-1); color: var(--mute-65); margin-top: 0.4rem; }

  /* 像 AI */
  .like-list { list-style: none; padding: 0; }
  .like-item { display: flex; gap: 0.8rem; align-items: baseline; padding: 0.7rem 0; border-bottom: 1px dotted var(--mute-15); }
  .like-dot { color: var(--mute-35); font-family: var(--mono); font-size: var(--step--1); }
  .like-t { font-family: var(--serif); font-size: var(--step-0); color: var(--ink); }

  /* 不像 AI */
  .unlike-list { list-style: none; padding: 0; }
  .unlike-item {
    display: flex; flex-direction: column; gap: 0.2rem;
    padding: 1rem 0 1rem 1rem; border-left: 2px solid var(--red); margin-bottom: 0.4rem;
  }
  .unlike-t { font-family: var(--kai); font-size: var(--step-1); color: var(--ink); }
  .unlike-note { font-family: var(--serif); font-size: var(--step--1); color: var(--mute-65); }

  /* 关键修正 */
  .key-correct {
    font-family: var(--serif); font-size: var(--step-1); line-height: 2.1; color: var(--ink);
    margin: 0; padding: 1.4rem 1.6rem; background: var(--paper-2); border: 1px solid var(--mute-15);
    text-align: center;
  }
  .tr-tail { font-family: var(--kai); font-size: var(--step-0); color: var(--mute-65); text-align: center; margin-top: 1.6rem; line-height: 1.95; }

  .tr-cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; padding-bottom: 3rem; }

  @media (max-width: 560px) {
    .score-row { grid-template-columns: 1fr; gap: 0.3rem; }
    .score-s { order: -1; }
  }
</style>
